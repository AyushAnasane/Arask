let a = 2;
let b = 7;
let c = 11;
let d = 15;

let target = 9;
let found = 0;

for (let i = 0; i < 4; i++) {
    for (let j = 0; j < 4; j++) {
        if (i < j) {
            if (i == 0) {
                if (j == 1) {
                    if (a + b == target) {
                        cout(a);
                        cout(b);
                        found = 1;
                    }
                }
            }

            if (i == 0) {
                if (j == 2) {
                    if (a + c == target) {
                        cout(a);
                        cout(c);
                        found = 1;
                    }
                }
            }

            if (i == 0) {
                if (j == 3) {
                    if (a + d == target) {
                        cout(a);
                        cout(d);
                        found = 1;
                    }
                }
            }

            if (i == 1) {
                if (j == 2) {
                    if (b + c == target) {
                        cout(b);
                        cout(c);
                        found = 1;
                    }
                }
            }

            if (i == 1) {
                if (j == 3) {
                    if (b + d == target) {
                        cout(b);
                        cout(d);
                        found = 1;
                    }
                }
            }

            if (i == 2) {
                if (j == 3) {
                    if (c + d == target) {
                        cout(c);
                        cout(d);
                        found = 1;
                    }
                }
            }
        }
    }
}